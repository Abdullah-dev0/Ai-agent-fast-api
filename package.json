{
  "name": "user-cache-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n next,agent \"next dev\" \"uv run --directory agent-server main.py\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "migrate": "node --env-file=.env scripts/migrate.mts",
    "db:schema": "docker compose exec -T db pg_dump -U app -d app --schema-only --no-owner --no-privileges --restrict-key=schema > db/schema.sql",
    "test": "vitest run"
  },
  "dependencies": {
    "better-auth": "^1.7.7",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
